[Unit]
Description=Sigurd GPT Realtime voice bridge for Zoom meeting %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=@ENV_FILE@
Environment=MEETING_PROVIDER=zoom
Environment=MEETING_REMOTE=@MEETING_REMOTE@
Environment=MEETING_SSH_IDENTITY=@SSH_IDENTITY@
Environment=MEETING_KEY=%i
Environment=OPENAI_REALTIME_MODEL=gpt-realtime-2.1
Environment=OPENAI_REALTIME_VOICE=cedar
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStartPre=@PYTHON@ @RUNTIME_SCRIPT@ --ssh -T -o BatchMode=yes -o ConnectTimeout=8 @MEETING_REMOTE@ pactl set-sink-volume agent_mic 100%%
ExecStartPre=@PYTHON@ @RUNTIME_SCRIPT@ --ssh -T -o BatchMode=yes -o ConnectTimeout=8 @MEETING_REMOTE@ pactl set-source-volume agent_mic_source 100%%
ExecStartPre=@PYTHON@ @RUNTIME_SCRIPT@ --ssh -T -o BatchMode=yes -o ConnectTimeout=8 @MEETING_REMOTE@ python3 /home/chip/.local/lib/sigurd-meeting/meeting_state.py zoom unmute %i
ExecStartPre=-@PYTHON@ @RUNTIME_SCRIPT@ --ssh -T -o BatchMode=yes -o ConnectTimeout=8 @MEETING_REMOTE@ python3 /home/chip/.local/lib/sigurd-meeting/meeting_state.py zoom ensure-recording %i
ExecStart=@PYTHON@ @RUNTIME_SCRIPT@
ExecStopPost=-@PYTHON@ @RUNTIME_SCRIPT@ --ssh -T -o BatchMode=yes -o ConnectTimeout=8 @MEETING_REMOTE@ python3 /home/chip/.local/lib/sigurd-meeting/meeting_state.py zoom mute %i
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
